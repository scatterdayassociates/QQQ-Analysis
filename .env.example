# Copy this file to .env.local for local development.
# Never commit your real key — .env.local is already gitignored.

# Your Massive (formerly Polygon.io) API key.
MASSIVE_API_KEY=your_massive_api_key_here

# Optional: override the API base URL. Defaults to https://api.massive.com
# MASSIVE_API_BASE_URL=https://api.massive.com

# Optional: free Alpha Vantage API key (sign up at
# https://www.alphavantage.co/support/#api-key), used for upcoming earnings
# dates on the Catalyst Tracker tab. If omitted, the app still works fine —
# Upcoming Catalysts just won't show Earnings rows (FOMC/CPI/jobs-report
# rows are unaffected).
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: free Finnhub API key (sign up at https://finnhub.io/register),
# used only for historical earnings tags on the Overnight Gap view (under
# the Intraday Daypart tab) — a separate feature from Catalyst Tracker's
# Upcoming Catalysts above, since it needs before-open/after-close timing
# that Alpha Vantage's calendar doesn't provide. If omitted, Overnight Gap
# still works, just without Earnings tags (FOMC/CPI/NFP tags are unaffected).
# FINNHUB_API_KEY=your_finnhub_api_key_here

# Required for the T10Y2Y Regime tab only — every other tab works without it.
# A MySQL connection string (this tab is the only part of the app with any
# persistent state; everything else in this dashboard computes on demand).
# Works with any managed MySQL (DigitalOcean, PlanetScale, RDS, etc.) or a
# local instance. See README's "T10Y2Y Regime database setup" section for
# the table DDL and a DigitalOcean walkthrough.
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Optional, only relevant if DATABASE_URL is set: shared secret checked by
# GET /api/yield-regime/refresh so it can't be triggered by anyone who finds
# the URL. Required if you wire up the Vercel Cron job in vercel.json (Vercel
# sends this automatically as a Bearer token to routes under vercel.json's
# crons config); set the same value here and in Vercel's project settings.
# CRON_SECRET=some_random_string

# Optional overrides for the T10Y2Y regime classification (see README) —
# sensible defaults are used if omitted.
# REGIME_THRESHOLD_BPS=5
# REGIME_LOOKBACK_DAYS=10
# REGIME_BACKFILL_START=2000-01-01
